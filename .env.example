# Application Environment
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (MySQL 8.0+ / TiDB Serverless)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=jd_analyser
DB_USER=root
DB_PASS=
# Set DB_SSL=true for Cloud MySQL (TiDB Cloud, Aiven). Leave false for local dev.
DB_SSL=false
# Optional custom CA bundle path (defaults to /etc/ssl/certs/ca-certificates.crt on Linux)
DB_SSL_CA=

# AI Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# System Paths & Execution
# Windows local dev: python | Linux VPS: python3 or /path/to/venv/bin/python
PYTHON_BIN=python
STORAGE_PATH=../storage/

# Free-Tier Limits
MAX_DAILY_SCANS_PER_USER=20
SYSTEM_DAILY_SCAN_CAP=1400
MAX_FILE_SIZE_BYTES=10485760
WATCHDOG_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=3

# Scoring Rubric Weights & Gating
WEIGHT_MUST_HAVE=0.50
WEIGHT_EXPERIENCE=0.25
WEIGHT_BONUS=0.25
ESSENTIAL_SKILL_GATE_THRESHOLD=50.0
MIN_GATE_MULTIPLIER=0.15
